enum TemplateCategory {
    CORPORATE
    CREATIVE
    DARK
    DEVELOPER
    MINIMAL
    MODERN
}

model Template {
    id        String           @id @default(uuid()) @map("id")
    ownerId   String?          @map("owner_id")
    name      String           @unique @map("name")
    body      String           @map("body")
    category  TemplateCategory @map("category")
    createdAt DateTime         @default(now()) @map("created_at")
    updatedAt DateTime         @updatedAt @map("updated_at")

    cvs    Cv[]
    drafts AiDraftCv[]

    @@index([category])
    @@index([updatedAt])
    @@map("templates")
}

model Cv {
    id String @id @default(uuid())

    userId String @map("user_id")
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    title      String    @map("title")
    content    Json      @map("content")
    templateId String   @map("template_id")
    template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

    isPublished    Boolean   @default(false) @map("is_published")
    publishedAt    DateTime? @map("published_at")
    publishedUntil DateTime? @map("published_until")
    viewsCount     Int       @default(0) @map("views_count")
    publicSlug     String?   @unique @map("public_slug")
    isDeactivated  Boolean   @default(false) @map("is_deactivated")
    coverLetter    String?   @map("cover_letter")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    cvViews     CvView[]
    cvFeedbacks CvFeedback[]

    @@index([userId])
    @@index([updatedAt])
    @@map("cvs")
}

enum AiProviderType {
    GEMINI
    OLLAMA
}

model AiProviderKey {
    id String @id @default(uuid())

    value      String         @unique @map("value")
    provider   AiProviderType @map("provider")
    name       String         @unique @map("name")
    usageLimit Int            @default(10) @map("usage_limit")
    usedToday  Int            @default(0) @map("used_today")
    usageDate  DateTime       @default(now()) @map("usage_date")
    isActive   Boolean        @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("ai_provider_keys")
}

model CvView {
    id String @id() @default(uuid())

    cvId String @map("cv_id")
    cv   Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)

    visitorId String @map("visitor_id")

    country String? @map("country")
    region  String? @map("region")
    city    String? @map("city")

    browser        String? @map("browser")
    browserVersion String? @map("browser_v")

    os     String? @map("os")
    device String? @map("device")

    referer String? @map("referer")

    viewedAt DateTime @default(now())

    @@index([cvId])
    @@index([cvId, visitorId])
    @@index([cvId, country])
    @@index([cvId, city])
    @@index([cvId, device])
    @@index([viewedAt])
    @@map("cv_views")
}

enum FileCategory {
    PDF
    PREVIEW
    PREVIEW_THUMBNAIL
    AVATAR
}

model CvFile {
    id String @id @default(uuid())

    cvId String @map("cv_id")
    category FileCategory @map("category")
    path String @map("path")
    filename String @map("file_name")
    mimeType String @map("mime_type")
    size     Int    @map("size")
    isPublished Boolean @default(true) @map("is_published")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime? @updatedAt @map("updated_at")

    @@unique([cvId, category])
    @@map("cv_files")
}

model CvFeedback {
    id String @id @default(uuid())

    cvId String @map("cv_id")
    cv   Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)

    email   String @map("email")
    message String @map("message")

    createdAt DateTime @default(now()) @map("created_at")

    @@index([email])
    @@map("cv_feedbacks")
}

enum AiDraftCvStatus {
  DRAFT
  AVATAR_UPLOADED
  GENERATING_CONTENT
  CONTENT_GENERATED
  PDF_GENERATED
  PREVIEW_GENERATED
  COMPLETED
  FAILED
  DELETED
}

model AiDraftCv {
    id String @id @default(uuid()) @map("id")

    userId String @map("user_id")
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    templateId String   @map("template_id")
    template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

    prompt   String          @map("prompt")
    content  Json?           @map("content")
    status   AiDraftCvStatus @map("status")
    provider AiProviderType? @map("provider")
    error    String?         @map("error")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime? @updatedAt @map("updated_at")

    @@index([userId])
    @@index([updatedAt])
    @@map("ai_draft_cvs")
}
