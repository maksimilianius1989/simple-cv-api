generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id String @id @default(uuid())

    email String? @unique @map("email")
    name  String? @map("name")

    acceptedTermsAt   DateTime? @map("accepted_terms_at")
    acceptedPrivacyAt DateTime? @map("accepted_privacy_at")
    termsVersion      String?   @map("terms_version")
    privacyVersion    String?   @map("privacy_version")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    identities UserIdentity[]
    cvs        Cv[]
    aiDraftCvs AiDraftCv[]
    // telegramLoginTokens TelegramLoginToken[]

    @@map("users")
}

model UserIdentity {
    id     String @id @default(uuid())
    userId String @map("user_id")
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    provider     AuthProviderType
    providerId   String           @map("provider_id")
    passwordHash String?          @map("password_hash")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([provider, providerId])
    @@map("user_identities")
}

enum AuthProviderType {
    LOCAL
    TELEGRAM
    GOOGLE
}

