generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id String @id @default(uuid())

    email    String? @unique @map("email")
    password String? @map("password")

    telegramId String  @unique @map("telegram_id")
    firstName  String? @map("first_name")
    lastName   String? @map("last_name")
    userName   String? @map("user_name")
    photoUrl   String? @map("photo_url")

    acceptedTermsAt   DateTime? @map("accepted_terms_at")
    acceptedPrivacyAt DateTime? @map("accepted_privacy_at")
    termsVersion      String?   @map("terms_version")
    privacyVersion    String?   @map("privacy_version")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    cvs                 UserCvData[]
    telegramLoginTokens TelegramLoginToken[]

    @@map("users")
}

model TelegramLoginToken {
    token String @id

    telegramId String @map("telegram_id")
    user       User   @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

    expiresAt DateTime @map("expires_at")
    createAt  DateTime @default(now()) @map("created_at")

    @@map("telegram_login_tokens")
}

model UserCvData {
    id String @id @default(uuid())

    userId String @map("user_id")
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    title       String @default("N/A") @map("title")
    userSummary String @map("user_summary")
    jsonSummary Json?  @map("json_summary")

    isPublished    Boolean   @default(false) @map("is_published")
    publishedAt    DateTime? @map("published_at")
    publishedUntil DateTime? @map("published_until")
    viewsCount     Int       @default(0) @map("views_count")
    publicSlug     String?   @unique @map("public_slug")

    isDeactivated Boolean @default(false) @map("is_deactivated")

    pdfPath     String? @map("pdf_path")
    previewPath String? @map("preview_path")

    avatar      String? @map("avatar")
    coverLetter String? @map("cover_letter")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    cvViews   CvView[]

    @@index([userId, createdAt])
    @@map("user_cv_data")
}

model PublishCv {
    id String @id @default(uuid())

    parentCvId String @map("parent_cv_id")

    publishedTo DateTime @map("published_to")
    createdAt   DateTime @default(now()) @map("created_at")

    @@map("publish_cvs")
}

model GeminiApiKey {
    id String @id @default(uuid())

    apiKey        String @unique @map("api_key")
    name          String @map("name")
    projectName   String @map("project_name")
    projectNumber String @map("project_number")

    usedToday  Int      @default(0) @map("used_today")
    usageLimit Int      @default(10) @map("usage_limit")
    usageDate  DateTime @default(now()) @map("usage_date")

    isActive Boolean @default(true) @map("is_active")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("gemini_api_keys")
}

model CvView {
    id String @id() @default(uuid())

    cvId String  @map("cv_id")
    ip   String? @map("ip")

    country        String? @map("country")
    region         String? @map("region")
    browser        String? @map("browser")
    browserVersion String? @map("browser_version")
    city           String? @map("city")
    referer        String? @map("referer")
    os             String? @map("os")
    device         String? @map("device")

    viewedAt DateTime @default(now()) @map("viewed_at")

    cv UserCvData @relation(fields: [cvId], references: [id])

    @@index([cvId])
    @@index([ip])
    @@map("cv_views")
}
