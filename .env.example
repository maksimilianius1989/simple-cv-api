NODE_ENV=development # development / production / test

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_DOMAIN= #https://simple-cv.life
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_MODE=polling # polling / webhook

DATABASE_URL= #"postgresql://<user>:<pass>@simple-cv-postgres:5432/<db>?schema=public"

JWT_SECRET= #someCustomString
JWT_ACCESS_TOKEN_TTL=2h
JWT_REFRESH_TOKEN_TTL=7d

COOKIE_DOMAIN= #.simple-cv.loc
APP_DOMAIN= #simple-cv.loc
API_DOMAIN= #api.simple-cv.loc

UPLOADS_PATH=/app/src/uploads
ANALYTICS_SALT=

OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST= #https://ai.simple-cv.life
OLLAMA_USER= #admin
OLLAMA_PASS=
OLLAMA_TIMEOUT=600000 #10min